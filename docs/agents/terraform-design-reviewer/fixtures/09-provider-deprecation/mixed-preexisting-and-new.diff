# PR の内容: sandbox_repository.tf を新規追加し、github_repository.sandbox を定義する。
# 前提: repository.tf は PR 前から非推奨属性を使っている（本 PR の差分ではない）。評価では worktree の
# repository.tf の代わりにこの前提を扱う。

diff --git a/sandbox_repository.tf b/sandbox_repository.tf
new file mode 100644
index 0000000..a5ecdc8
--- /dev/null
+++ b/sandbox_repository.tf
@@ -0,0 +1,14 @@
+resource "github_repository" "sandbox" {
+  name = "sandbox-repo"
+
+  visibility = "private"
+
+  has_downloads = true
+
+  lifecycle {
+    ignore_changes = [
+      visibility,
+      archived,
+    ]
+  }
+}
