# PR の内容: repository.tf の github_repository.this に vulnerability_alerts を追加する。

diff --git a/repository.tf b/repository.tf
index 47a9a61..427df50 100644
--- a/repository.tf
+++ b/repository.tf
@@ -75,10 +75,11 @@ resource "github_repository" "this" {
