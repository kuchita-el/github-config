# Fixture (ADR 0004 / 例外台帳・登録あり): gachanuma だけ Wiki を有効にする PR。
# 理由: gachanuma は利用者向けの確率計算の解説を Wiki で公開しており、恒常的に必要。
# 下記以外の既存ファイルは main のまま。README.md は下記の「README.md（PR 後）」の状態になる
# （評価では worktree の README.md の代わりに、下記の抜粋を PR 後の README.md として扱う）。

# --- variables.tf（PR 後、repositories の型の repository キー部分） ---
    repository = optional(object({
      archived    = optional(bool)
      description = optional(string)

      # PR で追加。null なら全リポ共通値を使う。
      has_wiki = optional(bool)
    }), {})

# --- repository.tf（PR 後、resource の変更行） ---
resource "github_repository" "this" {
  # ...（main と同じ属性は省略）...

  has_wiki = each.value.repository.has_wiki != null ? each.value.repository.has_wiki : local.repository_preset.has_wiki
}

# --- terraform.tfvars（PR 後、gachanuma エントリ） ---
  gachanuma = {
    visibility = "public"
    profile    = "app"

    repository = {
      has_wiki = true
    }
    branch_protection = {
      status_check_contexts       = ["lint", "typecheck", "test", "build", "e2e"]
      status_check_integration_id = 15368 # GitHub Actions
    }
  }

# --- README.md（PR 後、「例外台帳」節の表） ---
# | 設定種別 | 属性 | 元の区分 | 理由 | 登録した Issue / PR | 使用リポとリポごとの理由 | 見直しの条件 |
# |---|---|---|---|---|---|---|
# | repository | has_wiki | 全リポ共通値 | 利用者向けの解説を Wiki で公開するリポがあり、類型や共通値の見直しでは表せない | #999（所有者承認済み） | gachanuma: 確率計算の解説を Wiki で公開している | gachanuma が解説を Pages へ移したら削除する |
