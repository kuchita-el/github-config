# Fixture (ADR 0004 / 設定種別の追加): タグ保護を管理対象に加える PR。
# 下記以外の既存ファイル（repository.tf / branch_protection.tf / variables.tf / terraform.tfvars）は main のまま。
# 管理リポに既存のタグ用 Ruleset は無く、plan は public リポの分の create のみ。

# --- tag_protection.tf（PR で新規追加） ---
locals {
  # tag protection を適用するリポ。GitHub Free では private リポで Ruleset を使えないため public に絞る。
  public_repos = {
    for repo, cfg in var.repositories : repo => cfg if cfg.visibility == "public"
  }

  # 類型ごとに揃える値。4つの類型すべてが同じ属性の集合を持つ。
  tag_protection_by_profile = {
    distribution = { enforcement = "active" }
    infra        = { enforcement = "active" }
    app          = { enforcement = "disabled" }
    local_config = { enforcement = "disabled" }
  }

  # 類型を問わず全リポで揃える値。
  tag_protection_common = {
    name             = "tag protection"
    target           = "tag"
    ref_include      = ["~ALL"]
    ref_exclude      = []
    deletion         = true
    non_fast_forward = true
    update           = true
  }
}

resource "github_repository_ruleset" "tag_protection" {
  for_each = local.public_repos

  name        = local.tag_protection_common.name
  repository  = each.key
  target      = local.tag_protection_common.target
  enforcement = local.tag_protection_by_profile[each.value.profile].enforcement

  conditions {
    ref_name {
      include = local.tag_protection_common.ref_include
      exclude = local.tag_protection_common.ref_exclude
    }
  }

  rules {
    deletion         = local.tag_protection_common.deletion
    non_fast_forward = local.tag_protection_common.non_fast_forward
    update           = local.tag_protection_common.update
  }
}
