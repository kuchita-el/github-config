# Fixture (ADR 0004 / repositories のフィールド構造): github_repository の topics を管理対象に加える PR。
# topics はリポごとに異なる値（リポ固有値）。未指定のリポは topics なし。
# 全管理リポの実値は tfvars の宣言どおりで、plan は No changes。
# 下記以外の既存ファイルは main のまま。

# --- variables.tf（PR 後、repositories の型） ---
  type = map(object({
    visibility = string
    profile    = string

    # PR で追加。
    topics = optional(list(string), [])

    repository = optional(object({
      archived    = optional(bool)
      description = optional(string)
    }), {})

    branch_protection = optional(object({
      status_check_contexts       = optional(list(string), [])
      status_check_integration_id = optional(number)
    }), {})
  }))

# --- repository.tf（PR 後、resource の追加行） ---
resource "github_repository" "this" {
  # ...（main と同じ属性は省略）...

  topics = each.value.topics
}

# --- terraform.tfvars（PR 後、github-config エントリ） ---
  "github-config" = {
    visibility = "public"
    profile    = "infra"
    topics     = ["terraform", "github"]

    repository = {
      description = "Terraform-managed GitHub repository settings (rulesets etc.) as IaC"
    }
    branch_protection = {
      status_check_contexts       = ["fmt", "validate", "tflint"]
      status_check_integration_id = 15368 # GitHub Actions
    }
  }
