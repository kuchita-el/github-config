# Fixture (ADR 0004 / 値の区分と置き場所): github_repository に allow_update_branch を足す PR。
# 所有者の方針: 全管理リポで true に揃える。全管理リポの実値は既に true。
# 下記以外の既存ファイルは main のまま。

# --- variables.tf（PR 後、repositories の型の repository キー部分） ---
    repository = optional(object({
      archived    = optional(bool)
      description = optional(string)

      # PR で追加。
      allow_update_branch = optional(bool, true)
    }), {})

# --- repository.tf（PR 後、resource の追加行） ---
resource "github_repository" "this" {
  # ...（main と同じ属性は省略）...

  allow_update_branch = each.value.repository.allow_update_branch
}
