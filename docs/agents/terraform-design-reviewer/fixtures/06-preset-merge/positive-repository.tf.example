# Fixture: variables.tf の variable "repositories" で、visibility を既定値 "public" を持つ optional に変える PR。
# 元: variables.tf の variable "repositories"
# PR の目的: 管理対象に加えるリポの多くが public のため、terraform.tfvars のエントリで visibility の記述を省けるようにする。
#
# 差分イメージ（before → after）:
#   before: visibility = string
#   after:  visibility = optional(string, "public")
# 本 PR の変更は上記の1か所だけ。下記以外の既存ファイル（repository.tf / terraform.tfvars 等）は main のまま。
# terraform.tfvars の既存エントリは、いずれも visibility を宣言したまま変えない。

# --- variables.tf（PR 後、variable "repositories" の type。description と validation は main のままのため省略） ---
variable "repositories" {
  type = map(object({
    visibility = optional(string, "public")
    profile    = string

    repository = optional(object({
      archived     = optional(bool)
      description  = optional(string)
      homepage_url = optional(string)
      topics       = optional(set(string), [])
    }), {})

    branch_protection = optional(object({
      status_check_contexts       = optional(list(string), [])
      status_check_integration_id = optional(number)
    }), {})

    actions_permissions = optional(object({
      patterns_allowed = optional(set(string), [])
    }), {})
  }))
}
