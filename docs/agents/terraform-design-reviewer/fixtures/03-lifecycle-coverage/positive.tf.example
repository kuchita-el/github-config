# Fixture: repository.tf の github_repository.this の lifecycle.ignore_changes から archived を外す PR。
# 元: repository.tf の resource "github_repository" "this"
#
# 差分イメージ（before → after）:
#   before: ignore_changes = [visibility, archived]
#   after:  ignore_changes = [visibility]
# 本 PR の変更は上記の1か所だけ。下記以外の既存ファイル（locals の repository_preset、variables.tf /
# terraform.tfvars）は main のまま。

# --- repository.tf（PR 後、resource） ---
resource "github_repository" "this" {
  for_each = var.repositories

  name = each.key

  visibility = each.value.visibility

  archived     = each.value.repository.archived
  description  = each.value.repository.description
  homepage_url = each.value.repository.homepage_url
  topics       = each.value.repository.topics

  # ...（main と同じ全リポ共通値の属性と dynamic "security_and_analysis" ブロックは省略）...

  lifecycle {
    ignore_changes = [
      visibility,
    ]
  }
}
