# Fixture (negative): github_repository_ruleset を追加。
# 既存 branch_protection.tf と同じリソース型で、Administration RW で動作する。
# 期待: 観点 7 は発火しない。
#
# PR の内容: タグ保護を管理対象に加える。
# 下記以外の既存ファイル（repository.tf / branch_protection.tf / variables.tf / terraform.tfvars）は main のまま。
# 管理リポに既存のタグ用 Ruleset は無く、plan は public リポの分の create のみ。

# --- tag_protection.tf（PR で新規追加） ---
locals {
  # tag protection を適用するリポ。GitHub Free では private リポで Ruleset を使えないため public に絞る。
  tag_protection_targets = {
    for repo, cfg in var.repositories : repo => cfg if cfg.visibility == "public"
  }

  # 類型ごとに揃える値。4つの類型すべてが同じ属性の集合を持つ。
  tag_protection_profile_defaults = {
    distribution = { enforcement = "active" }
    infra        = { enforcement = "active" }
    app          = { enforcement = "disabled" }
    local_config = { enforcement = "disabled" }
  }

  # 類型を問わず全リポで揃える値。
  tag_protection_preset = {
    name             = "tag protection"
    target           = "tag"
    ref_include      = ["~ALL"]
    ref_exclude      = []
    deletion         = true
    non_fast_forward = true
    update           = true
  }
}

resource "github_repository_ruleset" "tag_protection" {
  for_each = local.tag_protection_targets

  name        = local.tag_protection_preset.name
  repository  = each.key
  target      = local.tag_protection_preset.target
  enforcement = local.tag_protection_profile_defaults[each.value.profile].enforcement

  conditions {
    ref_name {
      include = local.tag_protection_preset.ref_include
      exclude = local.tag_protection_preset.ref_exclude
    }
  }

  rules {
    deletion         = local.tag_protection_preset.deletion
    non_fast_forward = local.tag_protection_preset.non_fast_forward
    update           = local.tag_protection_preset.update
  }
}
