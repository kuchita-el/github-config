# Fixture: 全管理リポに同じ CODEOWNERS を配る設定種別を追加する PR。
# 本 PR の変更は下記のファイルの追加だけ。下記以外の既存ファイルは main のまま。

# --- codeowners.tf（PR で新規追加） ---
locals {
  codeowners_preset = {
    file                = ".github/CODEOWNERS"
    content             = "* @kuchita-el\n"
    commit_message      = "Add CODEOWNERS"
    overwrite_on_create = true
  }
}

resource "github_repository_file" "codeowners" {
  for_each = var.repositories

  repository          = each.key
  file                = local.codeowners_preset.file
  content             = local.codeowners_preset.content
  commit_message      = local.codeowners_preset.commit_message
  overwrite_on_create = local.codeowners_preset.overwrite_on_create
}
