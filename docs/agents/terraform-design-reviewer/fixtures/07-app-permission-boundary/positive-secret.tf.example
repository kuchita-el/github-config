# Fixture (positive): github_actions_secret を追加。
# App スコープ（Administration RW + Metadata R）の範囲外。
# 必要権限: Actions: Secrets RW
# 期待: 観点 7 が blocker で発火。
#
# PR の内容: 全管理リポに同じデプロイ用トークンを Actions secret として配る設定種別を追加する。
# 秘密値は HCP Workspace の sensitive な変数から渡す（tfvars には書かない）。他の既存ファイルは main のまま。

# --- variables.tf（PR 後、追加部分） ---
variable "deploy_token" {
  type        = string
  sensitive   = true
  description = "全管理リポに配るデプロイ用トークン。HCP Workspace の sensitive 変数で渡す。"
}

# --- actions_secrets.tf（PR で新規追加） ---
locals {
  actions_secrets_preset = {
    secret_name = "DEPLOY_TOKEN"
  }
}

resource "github_actions_secret" "actions_secrets" {
  for_each = var.repositories

  repository      = each.key
  secret_name     = local.actions_secrets_preset.secret_name
  plaintext_value = var.deploy_token
}
