# Fixture: 全管理リポに同じデプロイ用トークンを Actions secret として配る設定種別を追加する PR。
# 秘密値は HCP Workspace の sensitive な変数から渡す（tfvars には書かない）。
# 本 PR の変更は下記の variables.tf への追加と actions_secrets.tf の新規追加だけ。下記以外の既存ファイルは main のまま。

# --- variables.tf（PR 後、追加部分） ---
variable "deploy_token" {
  type        = string
  sensitive   = true
  description = "全管理リポに配るデプロイ用トークン。HCP Workspace の sensitive 変数で渡す。"
}

# --- actions_secrets.tf（PR で新規追加） ---
locals {
  actions_secrets_preset = {
    secret_name = "DEPLOY_TOKEN"
  }
}

resource "github_actions_secret" "actions_secrets" {
  for_each = var.repositories

  repository  = each.key
  secret_name = local.actions_secrets_preset.secret_name
  value       = var.deploy_token
}
