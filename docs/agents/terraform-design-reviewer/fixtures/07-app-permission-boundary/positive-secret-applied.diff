# PR の内容: actions_secrets.tf を新規追加し、全管理リポに同じデプロイ用トークンを Actions secret として配る
# github_actions_secret.deploy_token と、秘密値を受け取る variable "deploy_token" を加える。秘密値は HCP Workspace の
# sensitive な変数から渡す（tfvars には書かない）。

diff --git a/actions_secrets.tf b/actions_secrets.tf
new file mode 100644
index 0000000..fc26a94
--- /dev/null
+++ b/actions_secrets.tf
@@ -0,0 +1,19 @@
+variable "deploy_token" {
+  type        = string
+  sensitive   = true
+  description = "全管理リポに配るデプロイ用トークン。HCP Workspace の sensitive 変数で渡す。"
+}
+
+locals {
+  actions_secrets_preset = {
+    secret_name = "DEPLOY_TOKEN"
+  }
+}
+
+resource "github_actions_secret" "deploy_token" {
+  for_each = var.repositories
+
+  repository  = each.key
+  secret_name = local.actions_secrets_preset.secret_name
+  value       = var.deploy_token
+}
