# Fixture (negative): validation で列挙制約を表現している。
# 元: variables.tf の variable "repositories"
# 期待: 観点 2 は発火しない。
#
# PR の内容: branch_protection に per-repo の enforcement / allowed_merge_methods フィールドを追加する
# （per-repo の値を指定するリポの tfvars 宣言と、resource 側の null フォールバック参照は本フィクスチャでは省略）。
# 下記以外の既存ファイルは main のまま。

# --- variables.tf（PR 後） ---
variable "repositories" {
  description = "Managed repositories."

  type = map(object({
    visibility = string
    profile    = string

    repository = optional(object({
      archived    = optional(bool)
      description = optional(string)
    }), {})

    branch_protection = optional(object({
      status_check_contexts       = optional(list(string), [])
      status_check_integration_id = optional(number)

      # 新規追加: enforcement の上書き。文字列の列挙値（active / evaluate / disabled）
      # を取りうる。下記の validation で列挙制約を表現している。
      enforcement = optional(string)

      # 新規追加: merge_method の上書き。["squash","merge","rebase"] のサブセットを
      # 取りうる。下記の validation で列挙制約を表現している。
      allowed_merge_methods = optional(list(string))
    }), {})
  }))

  validation {
    condition = alltrue([
      for r in values(var.repositories) :
      length(r.branch_protection.status_check_contexts) == 0 || r.branch_protection.status_check_integration_id != null
    ])
    error_message = "branch_protection.status_check_integration_id is required when branch_protection.status_check_contexts is non-empty."
  }

  validation {
    condition = alltrue([
      for r in values(var.repositories) :
      contains(["distribution", "infra", "app", "local_config"], r.profile)
    ])
    error_message = "profile must be one of: distribution, infra, app, local_config (docs/design/terraform-structure.md §7)."
  }

  # 列挙値 validation: enforcement.
  validation {
    condition = alltrue([
      for r in values(var.repositories) :
      r.branch_protection.enforcement == null || contains(["active", "evaluate", "disabled"], r.branch_protection.enforcement)
    ])
    error_message = "branch_protection.enforcement must be one of: active, evaluate, disabled."
  }

  # 列挙値 validation: allowed_merge_methods の各要素.
  validation {
    condition = alltrue([
      for r in values(var.repositories) :
      r.branch_protection.allowed_merge_methods == null || alltrue([
        for m in r.branch_protection.allowed_merge_methods : contains(["squash", "merge", "rebase"], m)
      ])
    ])
    error_message = "branch_protection.allowed_merge_methods values must be a subset of [squash, merge, rebase]."
  }
}
