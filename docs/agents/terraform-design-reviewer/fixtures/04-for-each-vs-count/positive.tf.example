# Fixture (positive): count = N で複数リソースを生成。
# 各要素は固有名（リポ名）を持つので for_each が適切。
# 期待: 観点 4 が warning で発火。
#
# PR の内容: branch_protection.tf の Ruleset を、リポ名の一覧に対する count で展開する形で定義する
# （locals の branch_protection_preset と variables.tf / terraform.tfvars は main のまま）。

# --- branch_protection.tf（PR 後、resource） ---
resource "github_repository_ruleset" "branch_protection" {
  # NOTE: count はインデックスベース。一覧の先頭・中間要素を削除すると
  # 後続要素のインデックスが再採番され destroy/recreate される。
  # リポ名はキーになりうるので for_each = var.repositories を使うべき。
  count = length(keys(var.repositories))

  name        = local.branch_protection_preset.name
  repository  = keys(var.repositories)[count.index]
  target      = local.branch_protection_preset.target
  enforcement = local.branch_protection_preset.enforcement

  conditions {
    ref_name {
      include = ["~DEFAULT_BRANCH"]
      exclude = []
    }
  }

  rules {
    creation = local.branch_protection_preset.creation
    # ...（main と同じ rules は省略）...
  }
}
